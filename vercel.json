{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contacto",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/privacidad",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terminos",
      "destination": "/terms",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    },
    {
      "source": "/(|contact|terms|privacy|cookies|404)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(site.css|og-image.png|favicon.ico|favicon.svg|favicon-32.png|apple-touch-icon.png|icon-192.png|icon-512.png|logo.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "https://app.vetrareserve.com/assets/:path*"
    },
    {
      "source": "/:slug((?!(?:contact|terms|privacy|cookies|404|api|assets|img|fonts|public|r|legal|login|index)$)[a-z0-9][a-z0-9-]{1,48}[a-z0-9])",
      "destination": "https://app.vetrareserve.com/:slug"
    },
    {
      "source": "/:slug((?!(?:contact|terms|privacy|cookies|404|api|assets|img|fonts|public|r|legal|login|index)$)[a-z0-9][a-z0-9-]{1,48}[a-z0-9])/cancelar",
      "destination": "https://app.vetrareserve.com/:slug/cancelar"
    }
  ]
}